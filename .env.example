# ===========================================
# RST Style Studio LK — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.

# ---- Database (Prisma v7 + @prisma/adapter-pg) ----
# Used by prisma.config.ts for migrations and by PrismaPg adapter at runtime
DATABASE_URL="postgresql://user:password@localhost:5432/rst_studio?schema=public"
# Direct (non-pooled) connection used by Prisma migrations. With Supabase, DATABASE_URL
# is usually the pooler (port 6543) and DIRECT_URL the direct connection (port 5432).
DIRECT_URL="postgresql://user:password@localhost:5432/rst_studio?schema=public"

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Server-only. Needed for the admin media library and "revoke all sessions". Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ---- YouTube Data API v3 ----
YOUTUBE_API_KEY="your-youtube-api-key"
YOUTUBE_CHANNEL_ID="your-youtube-channel-id"

# ---- Spotify Web API (Client Credentials) ----
SPOTIFY_CLIENT_ID="your-spotify-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"
SPOTIFY_ARTIST_ID="your-spotify-artist-id"

# ---- Facebook Graph API ----
FACEBOOK_PAGE_ID="your-facebook-page-id"
FACEBOOK_ACCESS_TOKEN="your-facebook-page-access-token"

# ---- Vercel Cron Authentication ----
CRON_SECRET="your-random-cron-secret"

# ---- Email (Resend) ----
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="RST Style Studio <noreply@rststylestudiolk.com>"

# ---- Email (Gmail SMTP via Nodemailer) ----
# Sends the Music Arcade email-verification links. Use a Google App Password, not your account password.
EMAIL_USER="you@gmail.com"
EMAIL_PASS="your-16-char-app-password"

# ---- Music Arcade ----
# Signs the game_session cookie. Generate with: openssl rand -base64 32
GAME_SESSION_SECRET="a-long-random-string"

# ---- Site URL ----
NEXT_PUBLIC_SITE_URL="https://rststylestudio.lk"
