// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
  CONTRIBUTOR
}

model User {
  id         String   @id @default(uuid())
  supabaseId String   @unique
  email      String   @unique
  name       String?
  role       Role     @default(ADMIN)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  auditLogs     AuditLog[]
  notifications Notification[]
  claimRequests ClaimRequest[]
  profile       Profile?
}

model StudioSettings {
  id          String   @id @default(uuid())
  // General & Business Identity
  name        String   @default("RST Style Studio LK")
  email       String?
  phone       String?
  whatsapp    String?
  address     String?
  maintenanceMode Boolean @default(false)
  defaultCurrency String  @default("LKR")
  
  // Social Links
  facebookUrl String?
  youtubeUrl  String?
  spotifyUrl  String?
  instagramUrl String?
  tiktokUrl   String?
  xUrl        String?

  // SEO & Sharing
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?

  // Analytics & Marketing
  googleAnalyticsId String?
  facebookPixelId   String?

  // Theme & Aesthetics
  accentColor      String? @default("#9d2bee")
  enableAnimations Boolean @default(true)

  // Advanced Integrations
  adminAlertEmail  String?
  whatsappApiToken String?
  aiPromptContext  String?

  // Additional Business & Booking Settings
  bookingStatus         String  @default("AVAILABLE") // e.g. AVAILABLE, BUSY, AWAY
  minimumQuotationBudget Float   @default(0)
  taxRate               Float   @default(0) // Percentage

  // Additional Content & Feature Toggles
  enableMultiLanguage   Boolean @default(true)
  enableLiveChat        Boolean @default(false)
  displayClientReviews  Boolean @default(true)

  // Additional Media Settings
  autoPlayMusic         Boolean @default(false)

  // Customization
  footerText            String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}



model Song {
  id            String         @id @default(uuid())
  projectType   String         @default("SONG")
  titleEn       String
  titleSi       String
  slug          String         @unique
  description   String?
  coverImage    String?
  youtubeUrl    String?
  spotifyUrl    String?
  facebookUrl   String?
  genres        String[]
  releaseYear   Int?
  isFeatured    Boolean        @default(false)
  isDraft       Boolean        @default(false)
  contributions Contribution[]
  claims        ClaimRequest[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
}



model Contribution {
  id            String      @id @default(uuid())
  songId        String
  profileId     String?
  name          String
  role          String
  imageUrl      String?
  
  song          Song        @relation(fields: [songId], references: [id], onDelete: Cascade)
  profile       Profile?    @relation(fields: [profileId], references: [id], onDelete: SetNull)
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([songId, name, role])
}

model Profile {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  mainRole    String?
  bio         String?
  imageUrl    String?
  galleryImages String[] @default([])
  socialLinks Json?
  isActive    Boolean  @default(true)
  isApproved  Boolean  @default(false)
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  roles       Collaborator[]
  credits     Contribution[]

  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model Service {
  id            String   @id @default(uuid())
  nameEn        String
  nameSi        String
  nameIt        String?
  descriptionEn String?
  descriptionSi String?
  descriptionIt String?
  icon          String?
  isActive      Boolean  @default(true)
  basePrice     Float?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}

model PricingConfig {
  id        String   @id @default(uuid())
  itemKey   String   @unique
  type      String   // SERVICE, OPTION
  price     Float
  currency  String   @default("LKR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Collaborator {
  id        String   @id @default(uuid())
  profileId String
  role      String   // LYRICS, MELODY, MUSIC, MIX_MASTER, LEAD_GUITAR, FLUTE, SITAR, VIOLIN, etc.
  price     Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, role])
}

enum QuotationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

model QuotationRequest {
  id              String          @id @default(uuid())
  status          QuotationStatus @default(PENDING)
  name            String
  phone           String
  email           String?
  description     String?
  genre           String?
  selections      Json            @default("[]")
  attachments     Json            @default("[]")
  estimatedBudget Float
  adminNotes      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
}



model SocialCache {
  id        String   @id @default(uuid())
  platform  String   @unique // YOUTUBE, FACEBOOK, SPOTIFY
  data      Json
  lastSync  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String   // e.g., "UPDATE_SETTINGS", "CREATE_SONG"
  entity      String   // e.g., "Settings", "Song"
  entityId    String?  // ID of the affected entity
  details     Json?    // Specific changes or context
  ipAddress   String?
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum NotificationType {
  QUOTATION
  SYSTEM
  TEAM
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model ClaimRequest {
  id        String      @id @default(uuid())
  userId    String
  songId    String
  role      String
  proof     String?
  status    ClaimStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      Song        @relation(fields: [songId], references: [id], onDelete: Cascade)
}

// ── Game Player (Lightweight Registration) ──
model GamePlayer {
  id              String               @id @default(uuid())
  email           String               @unique
  username        String               @unique
  language        String               @default("en") // si, en, it
  verifiedAt      DateTime?            // Email verification timestamp
  verificationToken String?
  createdAt       DateTime             @default(now())
  
  scores          GameScore[]
  monthlyRanks    MonthlyLeaderboard[]
}

// ── Individual Game Scores ──
model GameScore {
  id            String      @id @default(uuid())
  playerId      String
  gameType      GameType
  month         Int         // 1-12
  year          Int
  score         Int
  ipAddress     String?
  createdAt     DateTime    @default(now())
  
  player        GamePlayer  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  
  // Ensure only ONE play per game per month per player
  @@unique([playerId, gameType, month, year])
  @@index([gameType, month, year, score(sort: Desc)])
}

enum GameType {
  TRIVIA
  PITCH_MATCH
  THEORY
  RHYTHM_TAP
}

// ── Monthly Leaderboard & Prize Management ──
model MonthlyLeaderboard {
  id            String      @id @default(uuid())
  gameType      GameType
  month         Int
  year          Int
  prizeDetails  String?     // Configured by admin
  
  // Winner tracking
  winnerId      String?
  winnerScore   Int?
  adminApproved Boolean     @default(false)
  emailSentAt   DateTime?
  
  createdAt     DateTime    @default(now())
  
  winner        GamePlayer? @relation(fields: [winnerId], references: [id], onDelete: SetNull)
  
  @@unique([gameType, month, year])
}

// ── Trivia Questions ──
model TriviaQuestion {
  id            String      @id @default(uuid())
  difficulty    String      // EASY, MEDIUM, HARD
  questionEn    String
  questionSi    String?
  questionIt    String?
  options       Json        // Array of { id, textEn, textSi, textIt }
  correctOption String
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
}


model HonoraryMention {
  id          String    @id @default(uuid())
  name        String
  title       String?
  description String?
  imageUrl    String?
  awardedAt   DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}
