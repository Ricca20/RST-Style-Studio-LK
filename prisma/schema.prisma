// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

model User {
  id         String   @id @default(uuid())
  supabaseId String   @unique
  email      String   @unique
  name       String?
  role       Role     @default(ADMIN)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model StudioSettings {
  id          String   @id @default(uuid())
  name        String   @default("RST Style Studio LK")
  email       String?
  phone       String?
  whatsapp    String?
  address     String?
  facebookUrl String?
  youtubeUrl  String?
  spotifyUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}



model Song {
  id            String         @id @default(uuid())
  projectType   String         @default("SONG")
  titleEn       String
  titleSi       String
  slug          String         @unique
  description   String?
  coverImage    String?
  youtubeUrl    String?
  spotifyUrl    String?
  facebookUrl   String?
  genres        String[]
  releaseYear   Int?
  isFeatured    Boolean        @default(false)
  isDraft       Boolean        @default(false)
  contributions Contribution[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}



model Contribution {
  id            String      @id @default(uuid())
  songId        String
  name          String
  role          String
  imageUrl      String?
  song          Song        @relation(fields: [songId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([songId, name, role])
}



model Service {
  id            String   @id @default(uuid())
  nameEn        String
  nameSi        String
  nameIt        String?
  descriptionEn String?
  descriptionSi String?
  descriptionIt String?
  icon          String?
  isActive      Boolean  @default(true)
  basePrice     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PricingConfig {
  id        String   @id @default(uuid())
  itemKey   String   @unique
  type      String   // SERVICE, OPTION
  price     Float
  currency  String   @default("LKR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Collaborator {
  id        String   @id @default(uuid())
  name      String
  role      String   // LYRICS, MELODY, MUSIC, MIX_MASTER, LEAD_GUITAR, FLUTE, SITAR, VIOLIN, etc.
  price     Float
  imageUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, role])
}

enum QuotationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

model QuotationRequest {
  id              String          @id @default(uuid())
  status          QuotationStatus @default(PENDING)
  name            String
  phone           String
  email           String?
  description     String?
  genre           String?
  selections      Json            @default("[]")
  attachments     Json            @default("[]")
  estimatedBudget Float
  adminNotes      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}



model SocialCache {
  id        String   @id @default(uuid())
  platform  String   @unique // YOUTUBE, FACEBOOK, SPOTIFY
  data      Json
  lastSync  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
